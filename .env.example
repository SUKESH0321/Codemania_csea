# ============================================
# Codemania — Environment Variables
# Copy this file to .env and fill in real values
# ============================================

# ── MongoDB ──────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codemania?retryWrites=true&w=majority

# ── Authentication Secrets ───────────────────
JWT_SECRET=change-me-to-a-random-string
ADMIN_SECRET=change-me-admin-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ── Execution Server Security ────────────────
# Must match between core backend and execution server
EXECUTION_SECRET=change-me-execution-secret

# ── Frontend Build-Time Variables ────────────
# These are baked into the Vite bundle at build time.
# In Docker, the frontend talks to the backend via the HOST machine ports.
VITE_CORE_BACKEND_URL=http://localhost:5000
VITE_EXECUTION_SERVER_URL=http://localhost:8080

# ── CORS (optional) ─────────────────────────
# Restrict CORS in production (comma-separated origins)
# Leave empty or * for allow-all (development)
CORS_ORIGIN=*
